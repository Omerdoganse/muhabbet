{
  "name": "muhabbet",
  "version": "1.0.0",
  "private": true,
  "description": "Arkadaşlarla oyun oynarken sesli ve yazılı sohbet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "author": "Omerdoganse",
  "homepage": "https://github.com/Omerdoganse/muhabbet",
  "build": {
    "appId": "com.muhabbet.app",
    "productName": "Muhabbet",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "artifactName": "Muhabbet-${version}.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
