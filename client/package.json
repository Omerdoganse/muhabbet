{
  "name": "muhabbet",
  "version": "1.0.0",
  "private": true,
  "description": "Arkadaşlarla oyun oynarken sesli ve yazılı sohbet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.muhabbet.app",
    "productName": "Muhabbet",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
